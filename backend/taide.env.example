# Source this file in the shell that starts the backend (not loaded automatically).
export TAIDE_API_BASE=http://127.0.0.1:8080/v1
export TAIDE_MODEL=taide-handover
# Optional only if the inference server requires authentication:
# export TAIDE_API_KEY=...
# Conservative input/output caps for the 4K-context 7B model.
export TAIDE_MAX_INPUT_BYTES=5000
export TAIDE_MAX_OUTPUT_TOKENS=1024
